# GEMINI_API_KEY: Required for server-side Gemini clinical triage summaries (@google/genai).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLITE_DB_PATH: Persistent server SQLite database file path (defaults to ./data/healthsync.sqlite).
SQLITE_DB_PATH="./data/healthsync.sqlite"

# VAULT_ENCRYPTION_KEY: 32-byte hex/base64 master key for AES-256-GCM PHI column encryption at rest.
# If omitted in local dev, the server generates and persists a random 256-bit key in ./data/.vault_key.
VAULT_ENCRYPTION_KEY=""

# DMO_EMERGENCY_PHONE: Destination phone number (E.164 format, e.g. +919876543210) for emergency SMS alerts & native sms: fallback.
DMO_EMERGENCY_PHONE="+9118001801104"

# REAL SMS GATEWAY OPTIONS (Configure either Twilio or Fast2SMS for live carrier delivery):
# Option A — Twilio Programmable SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Option B — Fast2SMS (India Bulk/Quick SMS Gateway)
FAST2SMS_API_KEY=""

# DMO_PROVISIONING_SECRET: Minimum 12-char server secret required to provision a new District Medical Officer (DMO)
# account when not already authenticated as an existing DMO administrator.
DMO_PROVISIONING_SECRET=""

# SMS_WEBHOOK_SECRET: Minimum 12-char shared webhook secret for authenticating inbound /api/sms/webhook requests
# when Twilio HMAC-SHA1 (TWILIO_AUTH_TOKEN + X-Twilio-Signature) is not used (e.g. Fast2SMS or GSM modem gateway).
SMS_WEBHOOK_SECRET=""
