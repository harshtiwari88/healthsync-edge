# GEMINI_API_KEY: Required for server-side Gemini clinical triage summaries (@google/genai).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLITE_DB_PATH: Persistent server SQLite database file path (defaults to ./data/healthsync.sqlite).
SQLITE_DB_PATH="./data/healthsync.sqlite"

# VAULT_ENCRYPTION_KEY: Required in production/serverless (>= 32 chars). Master key for AES-256-GCM PHI encryption at rest.
# Verified against vault_metadata.key_fingerprint at startup to prevent silent key regeneration or data loss.
VAULT_ENCRYPTION_KEY=""

# DURABLE REMOTE DATABASE FOR SERVERLESS DEPLOYMENTS (LibSQL / Turso HTTPS SQL Pipeline):
# Required when deploying to ephemeral serverless runtimes (e.g. Vercel) so records survive cold starts.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# DMO_PROVISIONING_SECRET: Minimum 12-char server secret required to provision a new District Medical Officer (DMO)
# account when not already authenticated as an existing DMO administrator (defaults to SWASTHYA-DMO-2026 when blank).
DMO_PROVISIONING_SECRET=""

# ASHA_ENROLLMENT_SECRET: Minimum 12-char Clinic Enrollment Code allowing authorized ASHA workers to verify
# their account at registration without waiting in the DMO approval queue (defaults to SWASTHYA-ASHA-2026 when blank).
ASHA_ENROLLMENT_SECRET=""

# DMO_EMERGENCY_PHONE: Primary destination phone number (E.164 format, e.g. +919876543210) for emergency SMS alerts.
DMO_EMERGENCY_PHONE="+9118001801104"

# ALLOWED_SMS_RECIPIENTS: Optional comma-separated E.164 phone allowlist for /api/sms/send (blocks arbitrary recipient abuse).
ALLOWED_SMS_RECIPIENTS=""

# SMS_DAILY_GLOBAL_LIMIT: Maximum outbound carrier SMS dispatches allowed per UTC day across the deployment (default 200).
SMS_DAILY_GLOBAL_LIMIT="200"

# REAL SMS GATEWAY OPTIONS (Configure either Twilio or Fast2SMS for live carrier delivery):
# Option A — Twilio Programmable SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Option B — Fast2SMS (India Bulk/Quick SMS Gateway)
FAST2SMS_API_KEY=""

# SMS_WEBHOOK_SECRET: Minimum 12-char shared webhook secret for authenticating inbound /api/sms/webhook requests
# when Twilio HMAC-SHA1 (TWILIO_AUTH_TOKEN + X-Twilio-Signature) is not used.
SMS_WEBHOOK_SECRET=""

# SESSION & PROXY SECURITY CONFIGURATION:
# TRUST_PROXY: Express trust proxy hop count or subnet (defaults to 1 on Cloud Run/Vercel/production, false on local).
TRUST_PROXY=""
# SESSION_TTL_MINUTES: Shift-scoped session lifetime in minutes (defaults to 480 for DMO / 720 for ASHA).
SESSION_TTL_MINUTES=""
# SESSION_IDLE_TIMEOUT_MINUTES: Idle session timeout in minutes (defaults to 120).
SESSION_IDLE_TIMEOUT_MINUTES=""
# CSP_FRAME_ANCESTORS: Optional space-separated CSP frame-ancestors override (defaults to 'self' in production).
CSP_FRAME_ANCESTORS=""
